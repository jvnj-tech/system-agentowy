# Skopiuj do pliku .env i uzupełnij.

# SEC EDGAR wymaga identyfikacji: imię, nazwisko i adres e-mail.
SEC_USER_AGENT="Imie Nazwisko adres@example.com"

# Darmowy klucz: https://finnhub.io/register
FINNHUB_API_KEY=

# Darmowy klucz: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Dostawca modelu językowego: gemini albo groq.
LLM_PROVIDER=gemini

# Darmowy klucz: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Darmowy klucz: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Lista modeli w kolejności preferencji (dostawca:model). Gdy model wyczerpie limit dobowy
# albo serwer jest przeciążony, zapytania przechodzą do następnego modelu z listy.
# Bez tej zmiennej używany jest jeden model z LLM_PROVIDER.
# LLM_MODELS=groq:openai/gpt-oss-120b,gemini:gemini-3.8-flash,groq:qwen/qwen3.8-27b

# 1 = tylko modele, które zaliczyły test (uv run marketagents-eval kwalifikacja).
LLM_REQUIRE_QUALIFIED=1

# Maksymalna liczba zapytań do modelu na minutę (0 = bez ograniczenia).
LLM_RPM=10

# Domyślne okna średnich kroczących: trzy okna SMA (krótkie, średnie, długie) i okno EMA.
# W aplikacji można je zmienić w panelu bocznym.
SMA_WINDOWS=20,50,200
EMA_WINDOW=20

# Katalog pamięci podręcznej i tryb offline (1 = tylko dane zapisane wcześniej).
MARKETAGENTS_CACHE_DIR=.cache
MARKETAGENTS_OFFLINE=0
